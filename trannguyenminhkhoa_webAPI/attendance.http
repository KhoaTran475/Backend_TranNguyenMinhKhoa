# Replace placeholders with your own configured email, password, OTP, IDs and tokens.
@baseUrl = https://localhost:7119/api
@username = admin.demo
@password = REPLACE_WITH_CONFIGURED_DEMO_PASSWORD
@challengeId = 00000000-0000-0000-0000-000000000000
@otp = 000000
@adminToken = REPLACE_AFTER_ADMIN_OTP
@lecturerToken = REPLACE_AFTER_LECTURER_OTP
@studentToken = REPLACE_AFTER_STUDENT_OTP
@classId = 1
@sessionId = 1
@studentId = 1
@attendanceId = 1
@lecturerId = 1
@userId = REPLACE_FROM_USERS
@qrToken = REPLACE_TOKEN_FIELD_PARSED_FROM_QR_PAYLOAD

### Request 3 (see README/API_CONTRACT for the demo sequence)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"username":"{{username}}","password":"{{password}}"}

### Request 4 (see README/API_CONTRACT for the demo sequence)
POST {{baseUrl}}/auth/verify-login-otp
Content-Type: application/json

{"challengeId":"{{challengeId}}","otp":"{{otp}}"}

### Request 5 (see README/API_CONTRACT for the demo sequence)
POST {{baseUrl}}/auth/resend-otp
Content-Type: application/json

{"challengeId":"{{challengeId}}"}

### Request 6 (see README/API_CONTRACT for the demo sequence)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{studentToken}}

### Admin dashboard
GET {{baseUrl}}/dashboard
Authorization: Bearer {{adminToken}}

### Request 7 (see README/API_CONTRACT for the demo sequence)
GET {{baseUrl}}/users?search=demo&page=1&pageSize=20
Authorization: Bearer {{adminToken}}

### Request 8 (see README/API_CONTRACT for the demo sequence)
GET {{baseUrl}}/students?search=SV&page=1&pageSize=20
Authorization: Bearer {{adminToken}}

